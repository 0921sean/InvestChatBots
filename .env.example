ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here

# Telegram (선택 — 투자방 메시지를 AI 봇에 입력하려면 설정)
# my.telegram.org → API development tools 에서 발급
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_GROUPS=t.me/group1,t.me/group2,@channel_name   # 쉼표로 여러 방 구분
# TELEGRAM_GROUP=t.me/single_group                      # 방 하나면 이것도 OK
TELEGRAM_SESSION=telegram_session
